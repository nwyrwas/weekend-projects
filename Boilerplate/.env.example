# ===========================================
# Application Configuration
# ===========================================

# Server port (default: 3000)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_db?schema=public"

# ===========================================
# JWT Configuration
# ===========================================

# Secret key for signing access tokens (use a strong random string, min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="your-super-secret-access-token-key-min-32-chars"

# Secret key for signing refresh tokens (use a different strong random string)
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-min-32-chars"

# Access token expiration (default: 15m)
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token expiration (default: 7d)
JWT_REFRESH_EXPIRES_IN="7d"

# ===========================================
# Security Configuration
# ===========================================

# CORS allowed origins (comma-separated for multiple origins)
# Examples:
#   - Single: http://localhost:3000
#   - Multiple: http://localhost:3000,https://myapp.com
#   - All (not recommended for production): *
CORS_ORIGIN="http://localhost:3000"

# Rate limiting: requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth rate limiting: stricter limits for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ===========================================
# Cookie Configuration
# ===========================================

# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=""

# Secure cookies (set to true in production with HTTPS)
COOKIE_SECURE=false

# SameSite cookie attribute: strict | lax | none
COOKIE_SAME_SITE="lax"
